{
  "name": "pylon-docs",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:dev": "vitepress dev",
    "docs:build": "node scripts/interfaces.mjs --check && vitepress build",
    "docs:preview": "vitepress preview",
    "docs:deploy": "wrangler deploy",
    "docs:deploy:check": "wrangler deploy --dry-run",
    "docs:preview:cloudflare": "wrangler dev",
    "docs:interfaces": "node scripts/interfaces.mjs",
    "docs:interfaces:sync": "node scripts/interfaces.mjs --source",
    "docs:interfaces:check": "node scripts/interfaces.mjs --check"
  },
  "devDependencies": {
    "vitepress": "1.6.4",
    "wrangler": "4.140.0"
  }
}
